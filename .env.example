# Copy to .env and fill in. The key is read by llm.py for the qualification
# and opener-drafting steps; everything else in the pipeline runs without it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (defaults to claude-opus-5)
# SIGNAL_MODEL=claude-opus-5

# Optional: enables the Google Places review source (rating + complaint
# patterns from Google reviews). Without it that source is skipped.
# GOOGLE_MAPS_API_KEY=...
