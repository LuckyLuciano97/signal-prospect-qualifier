# Secrets
.env

# Fetched pages and model responses (local caches, cheap to rebuild)
cache/
.llm_cache/
logs/

# Real prospect lists with real contacts stay out of git. The committed
# input_example.csv uses placeholder contacts only.
input_*.csv
!input_example.csv

__pycache__/
*.pyc

# Crawl bundles from n8n or tools/bundle_from_cache.py (rebuildable, can be large)
bundles/
bundles_n8n/

# Workflow exports carry the Places API key inline - never commit one.
signal-crawl*.json
n8n/*local*.json
